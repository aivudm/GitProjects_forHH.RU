{ TFileDialogEvents }

function TFileDialogEvents.OnFileOk(const pfd: IFileDialog): HResult;
var
  ShellItem: IShellItem;
  szName: PWideChar;
begin
  if pfd.GetResult(ShellItem)=S_OK then
  begin
    if ShellItem.GetDisplayName(SIGDN_FILESYSPATH, szName)=S_OK then
    begin
      Directory:=szName;
      CoTaskMemFree(szName);
    end;
  end;
  Result:=S_OK;
end;

